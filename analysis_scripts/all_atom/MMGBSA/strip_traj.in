parm {INPUT_PRMTOP}

trajin {INPUT_TRAJECTORY}

strip :295-785,822-1276

trajout {OUTPUT_STRIPPED_TRAJECTORY}

go

#FOR STRIP COMMAND, ONLY INSERT RESIDUES/RANGES YOU ARE NOT TRYING TO PERFORM MMGBSA ON. IN THIS EXAMPLE, RESIDUES 295-785 AND 822-1276 ARE NOT BEING ANALYZED,
#SO WE STRIP THEM FROM THE TRAJECTORY TO REMOVE ANY EXCESS NOISE FROM THE FINAL RESULTS
